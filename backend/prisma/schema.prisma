// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemCategory {
  ELECTRONICS
  FASHION
  HOME
  COLLECTIBLES
  GAMING
  BOOKS
  SPORTS
  OTHER
}

model User {
  id               String              @id @default(uuid())
  username         String              @unique
  email            String              @unique
  password         String
  avatarUrl        String?
  isOnline         Boolean             @default(false)
  lastSeen         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  messages         Message[]
  auctionsCreated  Auction[]           @relation("AuctionSeller")
  auctionsWon      Auction[]           @relation("AuctionHighestBidder")
  itemsCreated     Item[]              @relation("ItemSeller")
  bids             Bid[]               @relation("BidderBids")
  participations   ChatParticipation[]
  sentRequests     Friendship[]        @relation("SentRequests")
  receivedRequests Friendship[]        @relation("ReceivedRequests")
  apiKeys          ApiKey[]
}

model Item {
  id          String   @id @default(uuid())
  sellerId    String
  seller      User     @relation("ItemSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String
  condition   Int
  category    ItemCategory
  auction     Auction?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Auction{
  id              String    @id
  itemId          String    @unique
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User      @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  startPrice      Float
  currentPrice    Float
  highestBidderId String?
  highestBidder   User?     @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)
  status          String    @default("OPEN") //CLOSED OR OPEN
  version         Int       @default(0)
  endDate         DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bids            Bid[]
  messages        Message[]
  participations  ChatParticipation[]
}

model Bid {
  id          String  @id @default(uuid())
  auctionId   String
  userId      String
  amount      Float
  status      String  // 'ACCEPTED', 'REJECTED', etc.
  createdAt   DateTime  @default(now())

  auction     Auction   @relation(fields: [auctionId], references:  [id], onDelete: Cascade)
  user        User      @relation("BidderBids", fields: [userId], references: [id], onDelete: Cascade)
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  sender     User             @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  auctionId  String
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mediaUrl   String?
  isOffer    Boolean  @default(false)
  offerPrice Float?

  @@index([auctionId, createdAt])
}

model ChatParticipation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionId  String
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([userId, auctionId])
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
